{
  "name": "tp4-regalo-grupal",
  "version": "1.0.0",
  "description": "TP4 - Asincronismo e integración con Node.js y TypeScript: Lista compartida en tiempo real con WebSocket y SSE integrada con DummyJSON",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:slow": "CATALOG_DELAY_MS=2500 tsx src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
